CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/GRDB.swift" "${PODS_CONFIGURATION_BUILD_DIR}/agent_ast_translate" "${PODS_CONFIGURATION_BUILD_DIR}/agent_chat" "${PODS_CONFIGURATION_BUILD_DIR}/agent_sts_chat" "${PODS_CONFIGURATION_BUILD_DIR}/agent_translate" "${PODS_CONFIGURATION_BUILD_DIR}/agents_server" "${PODS_CONFIGURATION_BUILD_DIR}/ai_plugin_interface" "${PODS_CONFIGURATION_BUILD_DIR}/assistant_server" "${PODS_CONFIGURATION_BUILD_DIR}/ast_polychat" "${PODS_CONFIGURATION_BUILD_DIR}/ast_volcengine" "${PODS_CONFIGURATION_BUILD_DIR}/device_manager" "${PODS_CONFIGURATION_BUILD_DIR}/device_plugin_interface" "${PODS_CONFIGURATION_BUILD_DIR}/llm_openai" "${PODS_CONFIGURATION_BUILD_DIR}/llm_volcengine" "${PODS_CONFIGURATION_BUILD_DIR}/local_db" "${PODS_CONFIGURATION_BUILD_DIR}/permission_handler_apple" "${PODS_CONFIGURATION_BUILD_DIR}/service_manager" "${PODS_CONFIGURATION_BUILD_DIR}/sts_polychat" "${PODS_CONFIGURATION_BUILD_DIR}/sts_volcengine" "${PODS_CONFIGURATION_BUILD_DIR}/stt_azure" "${PODS_CONFIGURATION_BUILD_DIR}/translate_server" "${PODS_CONFIGURATION_BUILD_DIR}/translation_aliyun" "${PODS_CONFIGURATION_BUILD_DIR}/translation_azure" "${PODS_CONFIGURATION_BUILD_DIR}/translation_deepl" "${PODS_CONFIGURATION_BUILD_DIR}/translation_volcengine" "${PODS_CONFIGURATION_BUILD_DIR}/tts_azure" "${PODS_ROOT}/MicrosoftCognitiveServicesSpeech-iOS" "${PODS_ROOT}/WebRTC-SDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/MicrosoftCognitiveServicesSpeech-iOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/WebRTC-SDK"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/GRDB.swift/GRDB.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/agent_ast_translate/agent_ast_translate.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/agent_chat/agent_chat.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/agent_sts_chat/agent_sts_chat.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/agent_translate/agent_translate.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/agents_server/agents_server.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ai_plugin_interface/ai_plugin_interface.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/assistant_server/assistant_server.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ast_polychat/ast_polychat.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ast_volcengine/ast_volcengine.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/device_manager/device_manager.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/device_plugin_interface/device_plugin_interface.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/llm_openai/llm_openai.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/llm_volcengine/llm_volcengine.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/local_db/local_db.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/permission_handler_apple/permission_handler_apple.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/service_manager/service_manager.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/sts_polychat/sts_polychat.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/sts_volcengine/sts_volcengine.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/stt_azure/stt_azure.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/translate_server/translate_server.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/translation_aliyun/translation_aliyun.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/translation_azure/translation_azure.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/translation_deepl/translation_deepl.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/translation_volcengine/translation_volcengine.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/tts_azure/tts_azure.framework/Headers"
OTHER_LDFLAGS = $(inherited) -l"sqlite3" -framework "Foundation" -framework "GRDB" -framework "MicrosoftCognitiveServicesSpeech" -framework "WebRTC" -framework "agent_ast_translate" -framework "agent_chat" -framework "agent_sts_chat" -framework "agent_translate" -framework "agents_server" -framework "ai_plugin_interface" -framework "assistant_server" -framework "ast_polychat" -framework "ast_volcengine" -framework "device_manager" -framework "device_plugin_interface" -framework "llm_openai" -framework "llm_volcengine" -framework "local_db" -framework "service_manager" -framework "sts_polychat" -framework "sts_volcengine" -framework "stt_azure" -framework "translate_server" -framework "translation_aliyun" -framework "translation_azure" -framework "translation_deepl" -framework "translation_volcengine" -framework "tts_azure"
OTHER_SWIFT_FLAGS = $(inherited) -D SQLITE_ENABLE_FTS5
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
