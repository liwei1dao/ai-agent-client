# apps/services 后端测试/运行所需环境变量模板
# 复制为本地 .env 或在部署环境导出；.env 已被 .gitignore 忽略，切勿提交真实值。
# 未设置的变量对应的测试会自动 t.Skip（不会失败）。

# ── 数据库 ──────────────────────────────────────────────
# 格式: user:pass@tcp(host:port)/db?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_DSN=

# ── 阿里云 ──────────────────────────────────────────────
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_DASHSCOPE_API_KEY=          # 百炼(DashScope)录音文件转写 sk-...

# ── 火山引擎 / 字节 ─────────────────────────────────────
BYTEDANCE_ACCESS_KEY=              # 翻译服务 AK (AKLT...)
BYTEDANCE_SECRET_KEY=              # 翻译服务 SK
BYTEDANCE_AUDIO_APPID=             # 语音大模型 AppID
BYTEDANCE_AUDIO_TOKEN=            # 语音大模型访问 Token
BYTEDANCE_TOS_ACCESS_KEY=         # 对象存储 TOS AK
BYTEDANCE_TOS_SECRET_KEY=         # 对象存储 TOS SK

# ── LLM ────────────────────────────────────────────────
DEEPSEEK_API_KEY=                 # sk-...
OPENAI_API_KEY=                   # openai 兼容端点主 token
OPENAI_API_KEY_2=                 # 本地 one-api 网关 token
OPENAI_DOUBAO_TOKEN=              # 火山方舟豆包接入 token
GEMINI_API_KEY=                   # Google Gemini

# ── 腾讯云 ──────────────────────────────────────────────
TENCENT_SECRET_ID=                # COS 永久密钥 SecretId
TENCENT_SECRET_KEY=               # COS 永久密钥 SecretKey
# 短信-国内账号
TENCENT_SMS_APP_ID=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE1=
# 短信-海外账号
TENCENT_SMS_APP_ID_2=
TENCENT_SMS_SECRET_ID_2=
TENCENT_SMS_SECRET_KEY_2=
TENCENT_SMS_SIGN_NAME_2=
TENCENT_SMS_TEMPLATE2=

# ── Google ─────────────────────────────────────────────
GOOGLE_SA_JSON_PATH=              # 服务账号 JSON 凭据文件路径(该 .json 已 gitignore)
GOOGLE_MAPS_API_KEY=              # Google Maps (AIza...)

# ── 搜索 / 地图 / 天气 ──────────────────────────────────
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=                   # tvly-...
BING_SEARCH_KEY=                  # 必应搜索(bingsearch 测试沿用此名)
AMAP_API_KEY=                     # 高德地图
QWEATHER_API_KEY=                 # 和风天气(qweather/hefengweather 同一 key)
QWEATHER_API_HOST=                # 和风天气账户专属 API 主机名

# ── 第三方登录 (auth) ───────────────────────────────────
APPLE_AUTH_ID_TOKEN=              # 测试用 id_token/JWT
FIREBASE_AUTH_ID_TOKEN=
GOOGLE_AUTH_ID_TOKEN=
FACEBOOK_AUTH_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_AUTH_ID_TOKEN=
WECHAT_AUTH_APP_ID=
WECHAT_AUTH_APP_SECRET=
WECHAT_AUTH_CODE=

# ── 音乐 ────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── 聚合数据 (juhe) ─────────────────────────────────────
JUHE_WEATHER_API_KEY=
JUHE_FINANCE_API_KEY=
JUHE_TOUTIAO_API_KEY=

# ── 支付 ────────────────────────────────────────────────
# Apple 内购 / App Store Connect
APPLE_IAP_BUNDLE_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY_PEM=        # .p8 全文(含 BEGIN/END)，或用文件放置于 sys/pay/appleiap/
APPLE_IAP_TEST_JWS=               # 测试用 JWS 收据
# Google Play 内购
GOOGLE_IAP_SA_JSON=               # service account JSON 全文
GOOGLE_IAP_TEST_PURCHASE_TOKEN=
# 微信支付(wechat/alipay 测试共用)
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=      # apiclient_key.pem 路径(该 .pem 已 gitignore)
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_INTEGRATION_TEST=      # 置任意非空值以启用 alipay 包下的微信支付集成测试

# ── LLM 智能体平台 ──────────────────────────────────────
COZE_API_TOKEN=                   # Coze PAT (pat_...)
COZE_BOT_ID=
DIFY_API_KEY=                     # Dify 聊天应用 app-...
DIFY_WORKFLOW_KEY=                # Dify 工作流应用 app-...
DOUBAO_API_KEY=                   # 火山方舟 ARK API Key
DOUBAO_BOT_ID=

# ── 微软 Azure ──────────────────────────────────────────
AZURE_TRANSLATE_KEY=              # 文本翻译订阅密钥

# ── PayPal ─────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── 消息队列 ────────────────────────────────────────────
NATS_URL=                         # nats:// 连接串(含凭据/公网地址)
