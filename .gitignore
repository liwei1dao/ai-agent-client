# melos auto-generated path overrides (regenerated by `melos bootstrap`)
**/pubspec_overrides.yaml

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Build artifacts in ANY subdirectory (apps/*/build, etc.) — leading slash only
# matches the repo root, which is why these used to leak in.
**/build/
**/.cxx/
**/ephemeral/

# CocoaPods & iOS/macOS generated (regenerated by `pod install` / build) — NEVER commit
**/ios/Pods/
**/macos/Pods/
**/.symlinks/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/**/xcuserdata/
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral/

# Windows / Linux Flutter generated plugin registrants
**/windows/flutter/generated_plugin_registrant.*
**/windows/flutter/generated_plugins.cmake
**/linux/flutter/generated_plugin_registrant.*
**/linux/flutter/generated_plugins.cmake

# Android Flutter generated plugin registrant
**/android/**/GeneratedPluginRegistrant.java

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Gradle (cache / wrapper-local / machine-specific)
**/.gradle/
**/android/app/debug
**/android/app/profile
**/android/app/release

# Android signing & local config — NEVER commit (contains keys / passwords / paths)
*.jks
*.keystore
**/key.properties
**/local.properties

.env
*.g.dart
.claude/

# Payment / signing private keys — NEVER commit (Apple .p8, WeChat Pay, etc.)
*.p8
*.p12
*.pfx
**/apiclient_key.pem
**/apiclient_cert.pem
**/sys/pay/**/*.pem

# Compiled Go server binary (build artifact)
apps/services/console
