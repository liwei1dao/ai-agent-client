# melos auto-generated path overrides (regenerated by `melos bootstrap`)
**/pubspec_overrides.yaml

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Build artifacts in ANY subdirectory (apps/*/build, etc.) — leading slash only
# matches the repo root, which is why these used to leak in.
**/build/
**/.cxx/
**/ephemeral/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Gradle (cache / wrapper-local / machine-specific)
**/.gradle/
**/android/app/debug
**/android/app/profile
**/android/app/release

# Android signing & local config — NEVER commit (contains keys / passwords / paths)
*.jks
*.keystore
**/key.properties
**/local.properties

.env
*.g.dart
.claude/
